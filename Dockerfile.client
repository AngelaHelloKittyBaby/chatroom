FROM golang:1.25-alpine AS builder

WORKDIR /src

# 虚拟机无法访问默认 proxy.golang.org 时，使用国内模块代理
ENV GOPROXY=https://goproxy.cn,direct

COPY go.mod go.sum ./
COPY cmd ./cmd
COPY internal ./internal

RUN go build -o /out/chat-client ./cmd/client

FROM alpine:latest

WORKDIR /app

COPY --from=builder /out/chat-client ./chat-client

CMD ["./chat-client", "-addr", "server:8888"]

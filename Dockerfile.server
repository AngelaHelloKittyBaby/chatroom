FROM golang:1.25-alpine AS builder

WORKDIR /src

COPY go.mod go.sum ./
COPY cmd ./cmd
COPY internal ./internal

RUN go build -o /out/chat-server ./cmd/server

FROM alpine:latest

WORKDIR /app

COPY --from=builder /out/chat-server ./chat-server
COPY config.yaml ./config.yaml

EXPOSE 8888

CMD ["./chat-server", "-config", "config.yaml"]

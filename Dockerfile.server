FROM golang:1.25-alpine AS builder

WORKDIR /src

# 虚拟机无法访问默认 proxy.golang.org 时，使用国内模块代理
ENV GOPROXY=https://goproxy.cn,direct

COPY go.mod go.sum ./
COPY cmd ./cmd
COPY internal ./internal

RUN go build -o /out/chat-server ./cmd/server

FROM alpine:latest

WORKDIR /app

COPY --from=builder /out/chat-server ./chat-server
COPY config.yaml ./config.yaml

EXPOSE 8888

CMD ["./chat-server", "-config", "config.yaml"]
